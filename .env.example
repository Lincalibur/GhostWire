# ─────────────────────────────────────────────────────────────
#  GHOSTWIRE — Environment Configuration
#  Copy this file to `.env` and fill in real values before running.
# ─────────────────────────────────────────────────────────────

# HTTP server port
PORT=8080

# Runtime environment: development | production
NODE_ENV=development

# Absolute or relative path to the SQLite database file
DB_PATH=./backend/data/ghostwire.db

# ── Security / Sessions ──────────────────────────────────────
# High-entropy secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_value
# Session lifetime (minutes) before re-authentication is forced
SESSION_TTL_MINUTES=15

# ── OTP ──────────────────────────────────────────────────────
# OTP validity window in seconds
OTP_TTL_SECONDS=300
# Dispatch channel: console | email | sms
#   console -> prints the OTP to the server log (development only)
OTP_CHANNEL=console

# ── Out-of-band dispatch gateways (optional) ─────────────────
# Only required when OTP_CHANNEL is not "console".
SMS_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ── OSINT connector keys (optional) ──────────────────────────
# Connectors degrade gracefully to simulated output when unset.
SHODAN_API_KEY=
GRAYHATWARFARE_API_KEY=

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins ("*" to allow all in dev)
CORS_ORIGINS=*
